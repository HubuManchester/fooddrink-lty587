<?xml version="1.0" encoding="utf-8" ?>
<Shell x:Class="FoodDrinkApp.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:FoodDrinkApp.Views">

    <TabBar>
        <Tab Title="Home">
            <ShellContent ContentTemplate="{DataTemplate local:HomePage}"/>
        </Tab>
        <Tab Title="Diary">
            <ShellContent ContentTemplate="{DataTemplate local:FoodDiaryPage}"/>
        </Tab>
        <Tab Title="Nearby">
            <ShellContent ContentTemplate="{DataTemplate local:LocationPage}"/>
        </Tab>
        <Tab Title="Settings">
            <ShellContent ContentTemplate="{DataTemplate local:SettingsPage}"/>
        </Tab>
    </TabBar>

</Shell>