<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodDrinkApp.Views.LocationPage"
             Title="Nearby"
             BackgroundColor="#0A0A0A">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="25">

            <Label Text="📍 Current Location"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#D4AF37"
                   HorizontalOptions="Center"/>

            <Frame BackgroundColor="#1C1C1C" 
                   CornerRadius="15"
                   Padding="15">
                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                    <Label Text="📍" FontSize="30" VerticalOptions="Center"/>
                    <VerticalStackLayout>
                        <Label x:Name="CurrentLocationLabel" 
                               Text="Hubei University Wuchang Campus" 
                               FontSize="16" 
                               FontAttributes="Bold"
                               TextColor="#D4AF37"/>
                        <Label x:Name="CurrentAddressLabel"
                               Text="368 Youyi Avenue" 
                               FontSize="12" 
                               TextColor="#888888"/>
                    </VerticalStackLayout>
                    <Label Text="▼" FontSize="16" TextColor="#D4AF37" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnChangeLocationTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
            </Frame>

            <Label Text="Nearby Restaurants" 
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="#D4AF37"
                   Margin="0,10,0,5"/>

            <Label Text="Tap on a card to see details" 
                   FontSize="12" 
                   TextColor="#888888"
                   Margin="0,0,0,10"/>

            <CollectionView x:Name="RestaurantsList"
                            SelectionMode="Single"
                            SelectionChanged="OnRestaurantSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,8" 
                               CornerRadius="12" 
                               BackgroundColor="#1C1C1C"
                               Padding="12">
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="15">
                                <Label Text="{Binding Icon}" 
                                       FontSize="35" 
                                       VerticalOptions="Center"/>
                                <VerticalStackLayout Grid.Column="1">
                                    <Label Text="{Binding Name}" 
                                           FontAttributes="Bold" 
                                           FontSize="16"
                                           TextColor="#D4AF37"/>
                                    <Label Text="{Binding Distance}" 
                                           FontSize="12" 
                                           TextColor="#888888"/>
                                    <Label Text="{Binding Rating}" 
                                           FontSize="12" 
                                           TextColor="#D4AF37"/>
                                    <Label Text="{Binding Address}" 
                                           FontSize="10" 
                                           TextColor="#666666"
                                           MaxLines="1"/>
                                </VerticalStackLayout>
                                <Label Text="›" 
                                       FontSize="24" 
                                       TextColor="#D4AF37" 
                                       Grid.Column="2"
                                       VerticalOptions="Center"/>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>