<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodDrinkApp.Views.HomePage"
             Title="ÉPICURE"
             BackgroundColor="#0A0A0A">

    <ScrollView>
        <VerticalStackLayout Spacing="25" Padding="30">

            <Label Text="ÉPICURE" 
                   FontSize="42"
                   FontAttributes="Bold"
                   TextColor="#D4AF37"
                   HorizontalOptions="Center"/>

            <Label Text="Michelin Gourmet Guide" 
                   HorizontalOptions="Center"
                   TextColor="#888888"
                   FontSize="14"/>

            <BoxView HeightRequest="1" 
                     BackgroundColor="#D4AF37" 
                     Margin="50,10"/>

            <!-- Food Check-in Card -->
            <Frame BackgroundColor="#1C1C1C" CornerRadius="15" Padding="15">
                <VerticalStackLayout Spacing="15">
                    <Label Text="📸 Food Check-in" 
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="#D4AF37"
                           HorizontalOptions="Center"/>

                    <Button Text="📷 Take Photo"
                            Clicked="OnTakePhotoClicked"
                            BackgroundColor="#D4AF37"
                            TextColor="#0A0A0A"
                            HeightRequest="50"
                            CornerRadius="25"/>

                    <Button Text="🖼️ Choose from Gallery"
                            Clicked="OnPickPhotoClicked"
                            BackgroundColor="#D4AF37"
                            TextColor="#0A0A0A"
                            HeightRequest="50"
                            CornerRadius="25"/>

                    <Label Text="📱 Camera: Works on real device | Simulator will show prompt" 
                           FontSize="9" 
                           TextColor="#888888"
                           HorizontalOptions="Center"/>

                    <Label Text="🖼️ Gallery: Works on both simulator and real device" 
                           FontSize="9" 
                           TextColor="#888888"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Custom English Speech -->
            <Frame BackgroundColor="#1C1C1C" CornerRadius="12" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="✏️ Custom English Speech" 
                           TextColor="#D4AF37" 
                           FontAttributes="Bold"
                           FontSize="14"/>
                    <Entry x:Name="CustomEnglishEntry"
                           Placeholder="Enter English sentence, e.g., This pizza is very tasty!"
                           PlaceholderColor="#888888"
                           TextColor="#F5F5F5"
                           BackgroundColor="#2A2A2A"
                           HeightRequest="60"/>
                    <Button Text="🔊 Speak this English"
                            Clicked="OnSpeakCustomEnglishClicked"
                            BackgroundColor="#D4AF37"
                            TextColor="#0A0A0A"
                            HeightRequest="40"
                            CornerRadius="20"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Star Chef Recommendations -->
            <Label Text="✨ Star Chef Recommendations"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="#D4AF37"
                   Margin="0,20,0,10"/>

            <Label Text="👇 Tap card for nutrition info | Tap 🎤 button to speak" 
                   FontSize="12" 
                   TextColor="#888888"
                   Margin="0,-10,0,10"/>

            <CollectionView x:Name="RecommendListView">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,8" 
                               CornerRadius="12" 
                               BackgroundColor="#1C1C1C"
                               Padding="15">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnFoodCardTapped"
                                                      NumberOfTapsRequired="1"/>
                            </Frame.GestureRecognizers>

                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="15">
                                <Label Text="{Binding Icon}" FontSize="40" VerticalOptions="Center"/>
                                <VerticalStackLayout Grid.Column="1">
                                    <Label Text="{Binding Name}" 
                                           FontAttributes="Bold" 
                                           FontSize="16"
                                           TextColor="#D4AF37"/>
                                    <Label Text="{Binding Description}" 
                                           FontSize="12" 
                                           TextColor="#888888"
                                           MaxLines="2"/>
                                    <Label Text="{Binding Price}" 
                                           FontSize="12" 
                                           TextColor="#D4AF37"/>
                                </VerticalStackLayout>
                                <Button Text="🎤" 
                                        Grid.Column="2"
                                        Clicked="OnSpeakFoodInfoClicked"
                                        BackgroundColor="#D4AF37"
                                        TextColor="#0A0A0A"
                                        CornerRadius="20"
                                        HeightRequest="40"
                                        WidthRequest="50"
                                        VerticalOptions="Center"/>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Recent Records -->
            <Label Text="📔 Recent Food Records"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="#D4AF37"
                   Margin="0,20,10,10"/>

            <Label Text="👇 Tap 'View All' to go to Food Diary" 
                   FontSize="12" 
                   TextColor="#888888"
                   Margin="0,-10,0,10"/>

            <CollectionView x:Name="RecentRecordsListView" HeightRequest="200">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,8" 
                               CornerRadius="12" 
                               BackgroundColor="#1C1C1C"
                               Padding="15">
                            <Grid ColumnDefinitions="60, *" ColumnSpacing="15">
                                <Image Source="{Binding ImagePath}" 
                                       HeightRequest="50"
                                       WidthRequest="50"
                                       Aspect="AspectFill"/>
                                <VerticalStackLayout>
                                    <Label Text="{Binding FoodName}" 
                                           FontAttributes="Bold" 
                                           FontSize="14"
                                           TextColor="#D4AF37"/>
                                    <Label Text="{Binding Date}" 
                                           FontSize="10" 
                                           TextColor="#888888"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="📖 View All Food Diary"
                    Clicked="OnViewAllRecordsClicked"
                    BackgroundColor="Transparent"
                    TextColor="#D4AF37"
                    HeightRequest="40"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>