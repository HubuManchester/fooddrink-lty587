<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodDrinkApp.Views.FoodDiaryPage"
             Title="Food Diary"
             BackgroundColor="#0A0A0A">

    <Grid RowDefinitions="Auto, *">

        <VerticalStackLayout Grid.Row="0" Spacing="10" Padding="25">
            <Label Text="📔 Food Diary"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#D4AF37"
                   HorizontalOptions="Center"/>

            <Label Text="Record your daily meals"
                   FontSize="12"
                   TextColor="#888888"
                   HorizontalOptions="Center"/>

            <BoxView HeightRequest="1" BackgroundColor="#D4AF37" Margin="50,0"/>
        </VerticalStackLayout>

        <CollectionView x:Name="RecordsListView"
                        Grid.Row="1"
                        Margin="25">
            <CollectionView.EmptyView>
                <VerticalStackLayout Spacing="15" Padding="50">
                    <Label Text="📭" FontSize="50" HorizontalOptions="Center"/>
                    <Label Text="No food records yet" 
                           FontSize="16" 
                           TextColor="#888888"
                           HorizontalOptions="Center"/>
                    <Label Text="Tap the Camera tab to start recording" 
                           FontSize="12" 
                           TextColor="#666666"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,8" 
                           CornerRadius="12" 
                           BackgroundColor="#1C1C1C"
                           Padding="15">
                        <Grid ColumnDefinitions="80, *, Auto" ColumnSpacing="15">
                            <Image Source="{Binding ImagePath}" 
                                   HeightRequest="70"
                                   WidthRequest="70"
                                   Aspect="AspectFill"/>

                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="{Binding FoodName}" 
                                       FontAttributes="Bold" 
                                       FontSize="16"
                                       TextColor="#D4AF37"/>
                                <Label Text="{Binding Date}" 
                                       FontSize="11" 
                                       TextColor="#888888"/>
                                <Label Text="{Binding Notes}" 
                                       FontSize="12" 
                                       TextColor="#666666"
                                       MaxLines="2"/>
                            </VerticalStackLayout>

                            <Button Text="🗑️" 
                                    Grid.Column="2"
                                    Clicked="OnDeleteRecordClicked"
                                    BackgroundColor="#D4AF37"
                                    TextColor="#0A0A0A"
                                    CornerRadius="20"
                                    HeightRequest="40"
                                    WidthRequest="50"
                                    VerticalOptions="Center"/>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>